# Server Environment Variables — EXAMPLE FILE
# Copy this file to .env and fill in real values
# NEVER commit .env to Git

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
# For local MongoDB: mongodb://127.0.0.1:27017/caresync
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/caresync
MONGODB_URI=mongodb://127.0.0.1:27017/caresync

# ─── JWT Secrets (use long random strings — minimum 64 chars) ────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_very_long_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_very_long_random_secret_for_refresh_tokens

# Access token expires in (e.g., 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expires in (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────
# The URL where the React frontend is running
CLIENT_ORIGIN=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────
# Max login/register attempts per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15

# ─── Uploads ─────────────────────────────────────────────
# Max file size in bytes (5 MB default)
UPLOAD_MAX_SIZE_BYTES=5242880

# ─── Email (optional — app works without this) ───────────
# If not set, email sending is skipped silently
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="CareSync <no-reply@caresync.example>"

# ─── Cloudinary (optional — for production file storage) ─
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
